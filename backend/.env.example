# Optional. Open Food Facts is public and does not require a key for basic product lookup.
OPEN_FOOD_FACTS_USER_AGENT=NutriLensAI/1.0 (local development)
# Set to true to allow the API to download pretrained weights when first used.
ALLOW_MODEL_DOWNLOADS=false
MAX_UPLOAD_MB=12
# Optional trained two-class checkpoint (create by running training/train_classifier.py)
# Relative paths are resolved from the backend/ working directory.
NUTRILENS_CLASSIFIER_PATH=
NUTRILENS_CLASSIFIER_THRESHOLD=0.80
